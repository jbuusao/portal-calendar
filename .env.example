# MailerSend API token (MAILSERSEND_API_KEY is also accepted)
MAILERSEND_API_KEY=
MAILSERSEND_API_KEY=

# Verified sender on your MailerSend domain
MAIL_FROM=
MAIL_FROM_NAME=Calendar

# Daily activity digest recipient (falls back to config.adminEmail)
MAIL_ADMIN=

# SMTP defaults to MailerSend. Set SMTP_USER to send via SMTP instead of the API.
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Hour (local) after which yesterday's digest may send
MAIL_DIGEST_HOUR=7

APP_URL=http://127.0.0.1:3000

# Per-user address book size
MAX_CONTACTS_ENTRIES=100
